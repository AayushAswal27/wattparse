import sys; sys.path.insert(0, "..")
import pandas as pd
import numpy as np
from src.data.align import align

H5 = "../data/raw/ukdale.h5"

# Everything measured so far. F1 values are at swept thresholds.
RESULTS = [
    # appliance,      test house, train houses, F1
    ("kettle",         5, 4, 0.615),
    ("dish washer",    5, 2, 0.456),
    ("microwave",      5, 3, 0.049),
    ("washer dryer",   5, 1, 0.233),
    ("kettle",         2, 4, 0.904),
    ("dish washer",    2, 2, 0.747),
    ("microwave",      2, 3, 0.478),
]

WINDOWS = {5: ("2014-08-01", "2014-09-01"), 2: ("2013-06-01", "2013-07-01")}

rows = []
for appliance, house, n_train, f1 in RESULTS:
    start, end = WINDOWS[house]
    df = align(H5, house, appliance, start=start, end=end)
    app, mains = df[appliance], df["mains"]

    on = app > app.max() * 0.2
    # max, not a high quantile: at 0.08% density the 99.9th percentile
    # falls below the real peaks and understates SNR by 25x.
    peak = float(app.max())
    # Noise floor: how much the aggregate moves while this appliance is off.
    noise = float(mains[~on].std())
    groups = (on != on.shift()).cumsum()[on]
    lengths = on.groupby(groups).size()
    dur_s = float(lengths.median() * 6) if len(lengths) else 0.0

    rows.append({
        "appliance": appliance, "test_house": house,
        "peak_w": round(peak), "noise_w": round(noise),
        "snr": round(peak / noise, 2),
        "duration_min": round(dur_s / 60, 1),
        "density_pct": round(100 * float(on.mean()), 3),
        "n_train_houses": n_train,
        "f1": f1,
    })

t = pd.DataFrame(rows)
print(t.to_string(index=False))

# SNR sets the ceiling; training-house count decides whether it is reached.
# Washer dryer (SNR 4.52, 1 house, F1 0.233) and kettle on house 5
# (SNR 6.16, 4 houses, F1 0.615) are the pair that separates the two.
t["snr_x_houses"] = t["snr"] * t["n_train_houses"]
t["log_snr"] = np.log(t["snr"])

cols = ["snr", "log_snr", "snr_x_houses", "n_train_houses",
        "density_pct", "duration_min"]
print("\ncorrelation with F1:")
print(t[cols + ["f1"]].corr()["f1"].drop("f1")
      .sort_values(ascending=False).round(3).to_string())






