import sys; sys.path.insert(0, "..")
import numpy as np, pandas as pd, torch
from src.data.align import align
from src.data.windows import WINDOW, Normaliser, make_windows
from src.models.seq2point import Seq2Point
from src.evaluate.cross_house import predict, sweep_threshold
from src.evaluate.metrics import to_states, DEFAULT_THRESHOLDS

dev = torch.device("mps" if torch.backends.mps.is_available() else "cpu")
H5 = "../data/raw/ukdale.h5"

# House 1, after its training window ends - held out for every appliance.
SWEEP = ("2014-01-01", "2014-03-01")

def load(slug):
    ck = torch.load(f"../models/seq2point_{slug}_h2.pt", weights_only=False)
    m = Seq2Point(dilations=tuple(ck["dilations"])).to(dev)
    m.load_state_dict(ck["state_dict"])
    return m, Normaliser.from_dict(ck["normaliser"])

def series(model, norm, house, appliance, start, end):
    df = align(H5, house, appliance, start=start, end=end)
    X, y = make_windows(df, appliance, stride=1)
    half = WINDOW // 2
    idx = df.index[half:half + len(y)]
    return pd.Series(predict(model, X, norm, dev), index=idx), pd.Series(y, index=idx)

def f1_at(pred, truth, t, cfg):
    p = to_states(pred, t, cfg["min_on_s"], cfg["min_off_s"])
    tr = to_states(truth, cfg["on_power"], cfg["min_on_s"], cfg["min_off_s"])
    tp = int((p & tr).sum()); fp = int((p & ~tr).sum()); fn = int((~p & tr).sum())
    pr = tp/(tp+fp) if tp+fp else 0
    rc = tp/(tp+fn) if tp+fn else 0
    return (2*pr*rc/(pr+rc) if pr+rc else 0), pr, rc

for appliance, hi in [("kettle", 3000), ("dish washer", 2000), ("microwave", 1800)]:
    slug = appliance.replace(" ", "_")
    cfg = DEFAULT_THRESHOLDS[appliance]
    m, nrm = load(slug)

    # sweep on held-out house 1
    p1, t1 = series(m, nrm, 1, appliance, *SWEEP)
    sw = sweep_threshold(p1, t1, appliance, lo=100, hi=hi, step=50)
    best_t = int(sw.loc[sw.f1.idxmax(), "threshold"])

    # apply once to house 2
    start, end = ("2013-06-01", "2013-06-08") if appliance == "kettle" \
                 else ("2013-06-01", "2013-07-01")
    p2, t2 = series(m, nrm, 2, appliance, start, end)
    f_def, _, _ = f1_at(p2, t2, cfg["on_power"], cfg)
    f_swp, pr, rc = f1_at(p2, t2, best_t, cfg)

    print(f"{appliance:12s} sweep best {best_t:4d}W (h1 F1 {sw.f1.max():.3f}) "
          f"| house 2: default {f_def:.3f} -> swept {f_swp:.3f} "
          f"(P {pr:.3f} R {rc:.3f})")








import sys; sys.path.insert(0, "..")
import numpy as np, pandas as pd, torch
from src.data.align import align
from src.data.windows import WINDOW, Normaliser, make_windows
from src.models.seq2point import Seq2Point
from src.evaluate.cross_house import predict, sweep_threshold
from src.evaluate.metrics import to_states, DEFAULT_THRESHOLDS

dev = torch.device("mps" if torch.backends.mps.is_available() else "cpu")
H5 = "../data/raw/ukdale.h5"

def series(model, norm, house, appliance, start, end):
    df = align(H5, house, appliance, start=start, end=end)
    X, y = make_windows(df, appliance, stride=1)
    half = WINDOW // 2
    idx = df.index[half:half + len(y)]
    return pd.Series(predict(model, X, norm, dev), index=idx), pd.Series(y, index=idx)

def f1_at(pred, truth, t, cfg):
    p = to_states(pred, t, cfg["min_on_s"], cfg["min_off_s"])
    tr = to_states(truth, cfg["on_power"], cfg["min_on_s"], cfg["min_off_s"])
    tp = int((p & tr).sum()); fp = int((p & ~tr).sum()); fn = int((~p & tr).sum())
    pr = tp/(tp+fp) if tp+fp else 0
    rc = tp/(tp+fn) if tp+fn else 0
    return (2*pr*rc/(pr+rc) if pr+rc else 0), pr, rc

appliance = "washer dryer"
slug = appliance.replace(" ", "_")
cfg = DEFAULT_THRESHOLDS[appliance]

ck = torch.load(f"../models/seq2point_{slug}.pt", weights_only=False)
m = Seq2Point(dilations=tuple(ck["dilations"])).to(dev)
m.load_state_dict(ck["state_dict"])
nrm = Normaliser.from_dict(ck["normaliser"])

p1, t1 = series(m, nrm, 1, appliance, "2014-01-01", "2014-03-01")
sw = sweep_threshold(p1, t1, appliance, lo=50, hi=2000, step=50)
best_t = int(sw.loc[sw.f1.idxmax(), "threshold"])

p2, t2 = series(m, nrm, 5, appliance, "2014-08-01", "2014-09-01")
f_def, _, _ = f1_at(p2, t2, cfg["on_power"], cfg)
f_swp, pr, rc = f1_at(p2, t2, best_t, cfg)
print(f"sweep best {best_t}W (h1 F1 {sw.f1.max():.3f}) | "
      f"house 5: default {f_def:.3f} -> swept {f_swp:.3f} (P {pr:.3f} R {rc:.3f})")


