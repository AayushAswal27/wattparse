import sys; sys.path.insert(0, "..")
import numpy as np, pandas as pd, torch
from src.evaluate.metrics import to_states, DEFAULT_THRESHOLDS
from src.models.state_lstm import StateLSTM

pairs = pd.read_csv("../data/processed/state_pairs_dish_washer.csv",
                    index_col=0, parse_dates=True)
h2 = pairs[pairs["house"] == 2]
cfg = DEFAULT_THRESHOLDS["dish washer"]
truth = (h2["truth"] > cfg["on_power"])

def f1(p, t):
    tp = int((p & t).sum()); fp = int((p & ~t).sum()); fn = int((~p & t).sum())
    pr = tp/(tp+fp) if tp+fp else 0
    rc = tp/(tp+fn) if tp+fn else 0
    return round(2*pr*rc/(pr+rc), 3) if pr+rc else 0, round(pr,3), round(rc,3)

# rule baseline at several thresholds
for t in (10, 50, 100, 200, 500):
    p = to_states(h2["pred"], t, cfg["min_on_s"], cfg["min_off_s"])
    print(f"rule @{t:4d}W:  F1 {f1(p, truth)}")

# LSTM
ck = torch.load("../models/state_lstm_dish_washer.pt", weights_only=False)
dev = torch.device("mps" if torch.backends.mps.is_available() else "cpu")
m = StateLSTM(hidden=ck["args"]["hidden"], layers=ck["args"]["layers"]).to(dev)
m.load_state_dict(ck["state_dict"]); m.eval()

x = h2["pred"].to_numpy() / ck["scale"]
n = (len(x) // 512) * 512
seqs = torch.from_numpy(x[:n].reshape(-1, 512).astype("float32"))
probs = []
with torch.no_grad():
    for i in range(0, len(seqs), 64):
        probs.append(torch.sigmoid(m(seqs[i:i+64].to(dev))).cpu().numpy())
probs = np.concatenate(probs).reshape(-1)

lstm_pred = pd.Series(probs > 0.5, index=h2.index[:n])
print(f"\nLSTM:         F1 {f1(lstm_pred, truth.iloc[:n])}")


